// APRA ADI: entity highest consolidation level, at one publication-quarter end.
// Sum selected banks' RWA amounts, then convert AUD million to AUD billion.
// Source: pinned Table 4 column J; unit is in merged G2:J2 ($ million).
// Latest rows 7/24/53/78; prior rows 83/100/129/155, independently read.
DEFINE
    MEASURE 'fact_bank_quarterly'[Risk-Weighted Assets (AUD bn)] =
        VAR LatestReportDate =
            MAX ('fact_bank_quarterly'[report_date])
        VAR RWAAtLatestDate =
            CALCULATE (
                SUM ('fact_bank_quarterly'[rwa_million]),
                KEEPFILTERS (
                    'fact_bank_quarterly'[report_date] = LatestReportDate
                )
            )
        RETURN
            IF (
                ISBLANK (LatestReportDate),
                BLANK (),
                DIVIDE (RWAAtLatestDate, 1000)
            )

EVALUATE
VAR Checks =
    UNION (
        ROW (
            "check_name", "all_banks_latest",
            "actual_value", [Risk-Weighted Assets (AUD bn)],
            "expected_value", 1889.6783
        ),
        ROW (
            "check_name", "anz_latest",
            "actual_value", CALCULATE (
                [Risk-Weighted Assets (AUD bn)],
                'dim_bank'[bank_code] = "ANZ"
            ),
            "expected_value", 464.0258
        ),
        ROW (
            "check_name", "all_banks_2025_q4",
            "actual_value", CALCULATE (
                [Risk-Weighted Assets (AUD bn)],
                'dim_date'[year_quarter] = "2025 Q4"
            ),
            "expected_value", 1869.8191
        ),
        ROW (
            "check_name", "after_fact_2026_q2_blank",
            "actual_value", CALCULATE (
                [Risk-Weighted Assets (AUD bn)],
                'dim_date'[year_quarter] = "2026 Q2"
            ),
            "expected_value", BLANK ()
        ),
        ROW (
            "check_name", "non_reporting_month_2026_02_blank",
            "actual_value", CALCULATE (
                [Risk-Weighted Assets (AUD bn)],
                'dim_date'[year_month] = "2026-02"
            ),
            "expected_value", BLANK ()
        )
    )
RETURN
    ADDCOLUMNS (
        Checks,
        "status",
            IF (
                ISBLANK ([expected_value]),
                IF (ISBLANK ([actual_value]), "PASS", "FAIL"),
                IF (
                    NOT ISBLANK ([actual_value])
                        && ABS ([actual_value] - [expected_value]) < 0.00000001,
                    "PASS",
                    "FAIL"
                )
            )
    )
ORDER BY [check_name]
