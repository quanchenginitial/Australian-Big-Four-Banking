// APRA MADIS domestic, unconsolidated Australian-resident scope.
// Total residents deposits: a month-end balance.
// Evaluate all three checks, then use Update model with changes.
DEFINE
    MEASURE 'fact_bank_monthly'[Total Deposits (AUD bn)] =
        VAR LatestReportDate =
            MAX ('fact_bank_monthly'[report_date])
        VAR DepositsAtLatestDate =
            CALCULATE (
                SUM ('fact_bank_monthly'[deposits_million]),
                KEEPFILTERS (
                    'fact_bank_monthly'[report_date] = LatestReportDate
                )
            )
        RETURN
            DIVIDE (DepositsAtLatestDate, 1000)

EVALUATE
VAR Checks =
    UNION (
        ROW (
            "check_name", "all_banks_latest",
            "actual_value", [Total Deposits (AUD bn)],
            "expected_value", 2552.4870
        ),
        ROW (
            "check_name", "anz_latest",
            "actual_value", CALCULATE (
                [Total Deposits (AUD bn)],
                'dim_bank'[bank_code] = "ANZ"
            ),
            "expected_value", 438.3057
        ),
        ROW (
            "check_name", "all_banks_2026_06",
            "actual_value", CALCULATE (
                [Total Deposits (AUD bn)],
                'dim_date'[year_month] = "2026-06"
            ),
            "expected_value", 2531.6121
        )
    )
RETURN
    ADDCOLUMNS (
        Checks,
        "status",
            IF (
                NOT ISBLANK ([actual_value])
                    && ABS ([actual_value] - [expected_value]) < 0.00000001,
                "PASS",
                "FAIL"
            )
    )
ORDER BY [check_name]
