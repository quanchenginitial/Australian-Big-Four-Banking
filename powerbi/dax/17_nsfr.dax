// APRA ADI: published Net Stable Funding Ratio for one bank and quarter.
// Pinned Table 4 column V stores fractions: 1.149 means 114.90%; no /100.
// All/multiple banks and missing data return BLANK; no cross-bank aggregation.
// Available 2018 Q1-2026 Q1; 80 earlier source NULLs remain blank.
// Original source cells and independent expectations: work-notes/nsfr_source_checks.json.
DEFINE
    MEASURE 'fact_bank_quarterly'[NSFR (%)] =
        VAR HasSingleBank =
            HASONEVALUE ('dim_bank'[bank_code])
        VAR LatestReportDate =
            MAX ('fact_bank_quarterly'[report_date])
        VAR RatioAtLatestDate =
            CALCULATE (
                SELECTEDVALUE ('fact_bank_quarterly'[nsfr_ratio]),
                KEEPFILTERS (
                    'fact_bank_quarterly'[report_date] = LatestReportDate
                )
            )
        RETURN
            IF (
                HasSingleBank && NOT ISBLANK (LatestReportDate),
                RatioAtLatestDate,
                BLANK ()
            )

EVALUATE
VAR Checks =
    UNION (
        ROW (
            "check_name", "latest_all_blank",
            "actual_value", [NSFR (%)],
            "expected_value", BLANK ()
        ),
        ROW (
            "check_name", "latest_anz",
            "actual_value", CALCULATE (
                [NSFR (%)],
                'dim_bank'[bank_code] = "ANZ"
            ),
            "expected_value", 1.149000
        ),
        ROW (
            "check_name", "latest_cba",
            "actual_value", CALCULATE (
                [NSFR (%)],
                'dim_bank'[bank_code] = "CBA"
            ),
            "expected_value", 1.155000
        ),
        ROW (
            "check_name", "latest_nab",
            "actual_value", CALCULATE (
                [NSFR (%)],
                'dim_bank'[bank_code] = "NAB"
            ),
            "expected_value", 1.157000
        ),
        ROW (
            "check_name", "latest_wbc",
            "actual_value", CALCULATE (
                [NSFR (%)],
                'dim_bank'[bank_code] = "WBC"
            ),
            "expected_value", 1.123000
        ),
        ROW (
            "check_name", "anz_2025_q4",
            "actual_value", CALCULATE (
                [NSFR (%)],
                'dim_bank'[bank_code] = "ANZ",
                'dim_date'[year_quarter] = "2025 Q4"
            ),
            "expected_value", 1.157000
        ),
        ROW (
            "check_name", "before_available_2017_q4_anz_blank",
            "actual_value", CALCULATE (
                [NSFR (%)],
                'dim_bank'[bank_code] = "ANZ",
                'dim_date'[year_quarter] = "2017 Q4"
            ),
            "expected_value", BLANK ()
        ),
        ROW (
            "check_name", "first_available_2018_q1_anz",
            "actual_value", CALCULATE (
                [NSFR (%)],
                'dim_bank'[bank_code] = "ANZ",
                'dim_date'[year_quarter] = "2018 Q1"
            ),
            "expected_value", 1.149000
        ),
        ROW (
            "check_name", "after_fact_2026_q2_anz_blank",
            "actual_value", CALCULATE (
                [NSFR (%)],
                'dim_bank'[bank_code] = "ANZ",
                'dim_date'[year_quarter] = "2026 Q2"
            ),
            "expected_value", BLANK ()
        ),
        ROW (
            "check_name", "non_reporting_month_2026_02_anz_blank",
            "actual_value", CALCULATE (
                [NSFR (%)],
                'dim_bank'[bank_code] = "ANZ",
                'dim_date'[year_month] = "2026-02"
            ),
            "expected_value", BLANK ()
        )
    )
RETURN
    ADDCOLUMNS (
        Checks,
        "actual_pct", IF (ISBLANK ([actual_value]), "BLANK", FORMAT ([actual_value], "0.00%")),
        "expected_pct", IF (ISBLANK ([expected_value]), "BLANK", FORMAT ([expected_value], "0.00%")),
        "status",
            IF (
                ISBLANK ([expected_value]),
                IF (ISBLANK ([actual_value]), "PASS", "FAIL"),
                IF (
                    NOT ISBLANK ([actual_value])
                        && ABS ([actual_value] - [expected_value]) < 0.0000000001,
                    "PASS",
                    "FAIL"
                )
            )
    )
ORDER BY [check_name]
