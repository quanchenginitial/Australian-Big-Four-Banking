// APRA MADIS domestic, unconsolidated Australian-resident scope.
// Deposits by households, at one month-end.
// Independent expected values use the pinned source extract, in AUD billion.
DEFINE
    MEASURE 'fact_bank_monthly'[Household Deposits (AUD bn)] =
        VAR LatestReportDate =
            MAX ('fact_bank_monthly'[report_date])
        VAR HouseholdDepositsAtLatestDate =
            CALCULATE (
                SUM ('fact_bank_monthly'[household_deposits_million]),
                KEEPFILTERS (
                    'fact_bank_monthly'[report_date] = LatestReportDate
                )
            )
        RETURN
            IF (
                ISBLANK (LatestReportDate),
                BLANK (),
                DIVIDE (HouseholdDepositsAtLatestDate, 1000)
            )

EVALUATE
VAR Checks =
    UNION (
        ROW (
            "check_name", "all_banks_latest",
            "actual_value", [Household Deposits (AUD bn)],
            "expected_value", 1272.3877
        ),
        ROW (
            "check_name", "anz_latest",
            "actual_value", CALCULATE (
                [Household Deposits (AUD bn)],
                'dim_bank'[bank_code] = "ANZ"
            ),
            "expected_value", 198.3597
        ),
        ROW (
            "check_name", "all_banks_2026_06",
            "actual_value", CALCULATE (
                [Household Deposits (AUD bn)],
                'dim_date'[year_month] = "2026-06"
            ),
            "expected_value", 1247.6804
        ),
        ROW (
            "check_name", "all_banks_2019_02_blank",
            "actual_value", CALCULATE (
                [Household Deposits (AUD bn)],
                'dim_date'[year_month] = "2019-02"
            ),
            "expected_value", BLANK ()
        )
    )
RETURN
    ADDCOLUMNS (
        Checks,
        "status",
            IF (
                ISBLANK ([expected_value]),
                IF (ISBLANK ([actual_value]), "PASS", "FAIL"),
                IF (
                    NOT ISBLANK ([actual_value])
                        && ABS ([actual_value] - [expected_value]) < 0.00000001,
                    "PASS",
                    "FAIL"
                )
            )
    )
ORDER BY [check_name]
